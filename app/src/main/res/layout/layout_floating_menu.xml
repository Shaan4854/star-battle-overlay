<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menu_root"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_menu"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header / Drag Zone -->
    <RelativeLayout
        android:id="@+id/menu_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/iv_header_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_star_logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iv_header_icon"
            android:layout_toStartOf="@id/header_controls"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_badge"
                android:textColor="@color/neon_green"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- Right header controls: Drag handle hint & Minimize -->
        <LinearLayout
            android:id="@+id/header_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_drag_hint"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_drag_handle"
                android:contentDescription="Drag" />

            <ImageButton
                android:id="@+id/btn_minimize"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minimize"
                android:contentDescription="Minimize" />
        </LinearLayout>

    </RelativeLayout>

    <!-- Glass Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color"
        android:layout_marginBottom="12dp" />

    <!-- Status Badge & Detected Grid Info -->
    <LinearLayout
        android:id="@+id/status_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_badge"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="14dp">

        <View
            android:id="@+id/status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_status_badge"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_ready"
            android:textColor="@color/neon_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_grid_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NxN Auto"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Primary Action: SOLVE BUTTON -->
    <Button
        android:id="@+id/btn_solve"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_button_solve"
        android:text="@string/btn_solve"
        android:textColor="#0A0D14"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:stateListAnimator="@null"
        android:layout_marginBottom="8dp" />

    <!-- Secondary Action: CLEAR OVERLAY -->
    <Button
        android:id="@+id/btn_clear"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_button_clear"
        android:text="@string/btn_clear"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        android:layout_marginBottom="8dp" />

    <!-- Destructive Action: CLOSE MENU -->
    <Button
        android:id="@+id/btn_close"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_button_close"
        android:text="@string/btn_close"
        android:textColor="@color/accent_red"
        android:textSize="11sp"
        android:textStyle="bold"
        android:stateListAnimator="@null" />

</LinearLayout>
